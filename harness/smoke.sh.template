# for i in $(seq 1 30); do curl -sf "$BASE_URL" >/dev/null && break; sleep 1; done

# Example checks — replace with the actual main path walked in Phase 1:
curl -sf --max-time 10 "$BASE_URL/health" >/dev/null || { echo "✗ health"; exit 1; }
# curl -sf --max-time 10 "$BASE_URL/login" -d 'user=x&pass=y' | grep -q 'token' || { echo "✗ login"; exit 1; }

# Fix loop: one assertion per fix (Phase 5). Must be RED against the pre-fix
